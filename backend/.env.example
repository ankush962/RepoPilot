DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/ai_copilot
WORKSPACE_DIR=./workspace

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120
HEALTHCHECK_TIMEOUT_SECONDS=10

FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

ENVIRONMENT=development
LOG_LEVEL=INFO

# Authentication
AUTH_ENABLED=false
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=720

SESSION_COOKIE_NAME=repopilot_session
SESSION_EXPIRE_DAYS=7

# Worker
WORKER_ENABLED=true
WORKER_POLL_SECONDS=1
MAX_INDEX_ATTEMPTS=3
STALE_JOB_MINUTES=30

# AI / retrieval
MAX_CHAT_MESSAGE_CHARS=4000
MAX_RETRIEVAL_LIMIT=12

MODEL_TEMPERATURE=0
MODEL_NUM_PREDICT=2000
MODEL_NUM_CTX=8192

# Git auto sync
GIT_AUTO_SYNC_ENABLED=true
GIT_AUTO_SYNC_INTERVAL_SECONDS=60
GIT_COMPARE_MAX_COMMITS=100

# API rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# Development database initialization
AUTO_CREATE_TABLES=false
ENSURE_SCHEMA_ON_STARTUP=true

# Optional GitHub token
GITHUB_TOKEN=